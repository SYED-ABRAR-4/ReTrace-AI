# Copy this file to .env and fill in the values you need locally.
# Do not commit .env or any real secrets.

# Ollama settings for the open-weight local AI model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Optional: use a GitHub token for higher unauthenticated API rate limits.
# This should stay in local .env only and must never be committed.
GITHUB_TOKEN=

# Optional: override the default GitHub API base URL if needed.
GITHUB_API_BASE_URL=https://api.github.com
